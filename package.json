{
  "name": "@blindai/sdk",
  "version": "0.1.0",
  "description": "Fail-closed client for the BlindAI authorization API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.js",
    "test:contract": "npm run build && node --test test/contract/*.test.js",
    "check": "npm run typecheck && npm run typecheck:examples && npm test",
    "typecheck:examples": "tsc -p tsconfig.examples.json"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  },
  "license": "SEE LICENSE IN LICENSE"
}
